  {
   "name": "2 Catalog",
   "item": [
    {
     "name": "List products",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
         "const j = pm.response.json(); pm.test(\"Has pagination meta\", () => pm.expect(j.meta.total).to.be.a(\"number\"));",
         "const p = j.data.find(i => i.stock > 0); pm.collectionVariables.set(\"productId\", p._id); pm.collectionVariables.set(\"productPrice\", p.price); pm.collectionVariables.set(\"productBrand\", p.brand);"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/products?limit=12"
     }
    },
    {
     "name": "List categories",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
         "const j = pm.response.json(); pm.test(\"Categories have counts\", () => pm.expect(j.data[0].count).to.be.above(0)); pm.collectionVariables.set(\"categoryId\", j.data[0]._id);"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/categories"
     }
    },
    {
     "name": "List brands in a category",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
         "pm.test(\"Brands returned\", () => pm.expect(pm.response.json().data.length).to.be.above(0));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/brands?category={{categoryId}}"
     }
    },
    {
     "name": "Filter by brand",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
         "pm.test(\"All items match the brand\", () => pm.response.json().data.forEach(i => pm.expect(i.brand).to.eql(pm.collectionVariables.get(\"productBrand\"))));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/products?brand={{productBrand}}"
     }
    },
    {
     "name": "Search + sort",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/products?q=jacket&sort=price_asc"
     }
    },
    {
     "name": "Product detail",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
         "pm.test(\"Has description\", () => pm.expect(pm.response.json().data.description).to.be.a(\"string\"));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/products/{{productId}}"
     }
    },
    {
     "name": "Product not found (404)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
         "pm.test(\"Error code is NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/products/000000000000000000000000"
     }
    },
    {
     "name": "Brands with invalid category (422)",
     "event": [
      {
       "listen": "test",
