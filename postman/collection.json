{
 "info": {
  "name": "Thrift Store API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Run folders in order 1 to 7 (Collection Runner). Requires seeded data: npm run seed."
 },
 "item": [
  {
   "name": "1 Auth",
   "item": [
    {
     "name": "Register (new user)",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set(\"newEmail\", \"pm\" + Date.now() + \"@thrift.test\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
         "const j = pm.response.json(); pm.test(\"Returns token\", () => pm.expect(j.data.token).to.be.a(\"string\"));",
         "pm.collectionVariables.set(\"newUserToken\", j.data.token);"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/auth/register",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Password123!\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    },
    {
     "name": "Register duplicate email (409)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
         "pm.test(\"Error code is EMAIL_TAKEN\", () => pm.expect(pm.response.json().error.code).to.eql(\"EMAIL_TAKEN\"));"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/auth/register",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Dup\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Password123!\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    },
    {
     "name": "Register invalid input (422)",
