# Copy to .env and fill in. Never commit the real .env.
PORT=4000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/thrift
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:5173

# Payments: "maya" (sandbox, as deployed) or "paymongo"
PAYMENT_PROVIDER=maya
PUBLIC_API_URL=https://your-api.onrender.com
MAYA_PUBLIC_KEY=__
MAYA_SECRET_KEY=__
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_WEBHOOK_TOKEN=change_me
# Only needed when PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# AI shopping assistant: "gemini" (default) or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-2.0-flash
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=xxx
OPENAI_MODEL=gpt-4o-mini
